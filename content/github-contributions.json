        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L851",
        "compare": "https://github.com/JamePeng/llama-cpp-python/compare/4854c7d305650b6bc9cf2dc805931a5bf2e40dd0...85913abc4f4b9191b28bc6bc482ae9369e0ba624"
