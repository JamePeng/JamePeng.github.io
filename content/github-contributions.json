  "releaseHistory": {
    "source": "https://github.com/JamePeng/llama-cpp-python/blob/main/CHANGELOG.md",
    "checkedAt": "2026-10-25",
    "start": {
      "date": "2025-03-13",
      "version": "0.3.8",
      "url": "https://github.com/JamePeng/llama-cpp-python/commit/37ae87336856ccca6184422e9889b48f3abc73b9"
    },
    "releases": [
      {
        "version": "0.4.5",
        "title": "LiliCorr、Soprano TTS 与多模态缓存",
        "changes": [
          "支持 LiliCorr 块解码、投影锚点和检查点恢复，对齐 MTP / DFlash 的 token 抑制与候选概率处理。",
          "新增 Soprano 非流式 WAV / PCM 合成，补充音频流查询、CLI 示例与回归测试。",
          "统一媒体缓存与提示归一化，改善多轮图像状态复用，并按资源归属选择设备端检查点或主机快照。",
          "修正模型抑制 token、语法掩码和强制采样的配合，开放 LlamaModel.suppress_tokens()。"
        ],
        "releaseUrl": "https://github.com/JamePeng/llama-cpp-python/releases/tag/v0.4.5-cu131-win-20261025",
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L10"
      },
      {
        "version": "0.4.4",
        "title": "推测解码、混合状态与前缀缓存",
        "changes": [
          "跳过推测请求结束时不再使用的目标检查点，减少状态导出和冗余拷贝。",
          "对齐 MTP 验证回调、原生回滚容量与检查点所有权，修复中断后的恢复路径。",
          "改善关闭检查点时的混合模型前缀复用与状态恢复，统一 RAM、磁盘和 Trie 的匹配规则。",
          "补充缓存与回滚基准、回归测试和使用文档，将 Python 3.9 CI 固定到 Ubuntu 24.04。"
        ],
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L120",
        "compare": "https://github.com/JamePeng/llama-cpp-python/compare/ce261d12b5810fb4c6e695efc85d5e8cf23f0630...b7cc3e17cec3385cdfd8789697985b8c8f4eccfa"
      },
      {
        "version": "0.4.3",
        "title": "多模态向量与 MTP 图像推理",
        "changes": [
          "新增文本、图像和音频的 MTMD embedding，补充 Qwen3-VL 使用指南与归一化修复。",
          "支持 MTMD 图像对话结合 MTP，扩展 LlamaBatchExt 与独立 hidden state 输入。",
          "复用原生库打包多版本 Python wheel，完善 CUDA 版本传递、测试和文档。"
        ],
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L219",
        "compare": "https://github.com/JamePeng/llama-cpp-python/compare/8fe0a5f5514cdbd3fff1c60b3ff21fb0eb7b5059...6c22029fe41885e1875823b96d5b2076e152c7ba"
      },
      {
        "version": "0.4.2",
        "title": "RPC 设备选择与扩展批处理",
        "changes": [
          "支持为模型选择远程 RPC 与本地设备，并向服务端开放配置。",
          "扩展 batch、ggml 缓冲区接口，修正状态返回类型及量化、训练参数 ABI。",
          "为 CUDA、Metal wheel 启用 RPC，补充跨平台后端加载测试与部署指南。"
        ],
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L335",
        "compare": "https://github.com/JamePeng/llama-cpp-python/compare/6332d8d4fcd3d4ae0c92974161348d3e8eb1e2c0...6126add06f9c57678a6ce5951c4676d36dc52758"
      },
      {
        "version": "0.4.1",
        "title": "通用多模态模板与后端绑定",
        "changes": [
          "扩展视觉、视频输入及媒体标记的模板兼容，统一加载模型自带的聊天模板。",
          "补齐 Jinja 模板辅助函数，修正解码位置结构体 ABI，扩展 ggml 后端绑定。"
        ],
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L424",
        "compare": "https://github.com/JamePeng/llama-cpp-python/compare/5c83af7dcfed4ffdd6bda791835d92698c90a398...3e99f13c8c3cc236bafbedf3448ec2ef0d7df797"
      },
      {
        "version": "0.4.0-Milestone",
        "title": "语音生成与运行时可靠性",
        "changes": [
          "加入基于 MTMD 的 Qwen3-TTS、Pocket TTS 音频生成。",
          "扩展语法根规则、延迟触发与 JSON Schema 转换，改进语法构造。",
          "整理状态快照、混合模型检查点、原生取消与资源回收，统一测试和 Wiki。"
        ],
        "url": "https://github.com/JamePeng/llama-cpp-python/blob/3fc39b2ebcfbee10a6f64754b333eae2fe1ccc82/CHANGELOG.md?plain=1#L486",
